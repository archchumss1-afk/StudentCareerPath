PGHOST=localhost
PGPORT=5432
PGDATABASE=edupath
PGUSER=postgres
# Set PGPASSWORD privately in your PowerShell session or in backend/.env.
# Generate SESSION_SECRET using the command in AUTH_SETUP.md.
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
# Production uses HTTPS, Secure cookies, and the __Host- cookie prefix.
# For a known local reverse proxy only, configure TRUST_PROXY=loopback.
